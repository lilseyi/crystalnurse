---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileMenu from "../components/layout/MobileMenu.astro";
import { asset } from "../lib/asset";
import { site } from "../lib/site";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Crystal Care Nursing, LLC provides skilled and non-skilled home health care across Potomac, Maryland and Washington, DC — promoting your independence at home.",
  ogImage = "/images/hero-home.jpeg",
} = Astro.props;

const faviconHref = asset("/favicon.png");
const ogImageHref = new URL(asset(ogImage), Astro.site ?? "https://crystalnurse.com").href;
const fullTitle = `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://crystalnurse.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Figtree:wght@400;500;600;700&display=swap"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <script is:inline>document.documentElement.classList.add("js-enabled");</script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-deep focus:px-3 focus:py-2 focus:text-white"
      >Skip to main content</a
    >

    <Header />
    <MobileMenu />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/mobile-menu.ts";
      import "../scripts/scroll-animate.ts";
    </script>
  </body>
</html>
