---
export interface Props {
  href?: string;
  variant?: "primary" | "outline" | "ghost" | "care";
  size?: "sm" | "md" | "lg";
  class?: string;
  type?: "button" | "submit";
  external?: boolean;
  "aria-label"?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  external = false,
  "aria-label": ariaLabel,
} = Astro.props;

const variants = {
  primary: "bg-brand text-white hover:bg-brand-600 active:bg-brand-700 shadow-soft",
  care: "bg-care text-white hover:bg-[#cf7249] active:bg-[#bd6740] shadow-soft",
  outline:
    "bg-transparent text-deep border-[1.5px] border-deep/25 hover:border-brand hover:text-brand",
  ghost: "bg-transparent text-deep hover:text-brand",
};

const sizes = {
  sm: "px-4 py-2.5 text-sm",
  md: "px-6 py-3 text-[0.95rem]",
  lg: "px-7 py-3.5 text-base",
};

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-semibold leading-none transition-all duration-150 disabled:opacity-60 disabled:pointer-events-none";

const cls = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href ? (
    <a href={href} class={cls} aria-label={ariaLabel} {...externalAttrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
