---
import Eyebrow from "./Eyebrow.astro";

export interface Props {
  eyebrow?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
  class?: string;
}

const {
  eyebrow,
  align = "center",
  as: Tag = "h2",
  class: className = "",
} = Astro.props;

const alignClass =
  align === "center" ? "items-center text-center" : "items-start text-left";
// Fraunces set large and light for warmth; tight leading for authority.
const headingSize =
  Tag === "h1"
    ? "text-4xl sm:text-5xl md:text-6xl"
    : "text-3xl sm:text-4xl md:text-[2.75rem]";
---

<div class={`flex flex-col gap-4 ${alignClass} ${className}`}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <Tag class={`font-display font-light leading-[1.08] ${headingSize}`}>
    <slot />
  </Tag>
  {
    Astro.slots.has("description") && (
      <p class="max-w-prose text-base leading-relaxed text-muted sm:text-lg">
        <slot name="description" />
      </p>
    )
  }
</div>
