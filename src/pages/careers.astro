---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import CallToAction from "../components/sections/CallToAction.astro";
import { site } from "../lib/site";
---

<BaseLayout
  title="Careers"
  description="Join Crystal Care Nursing. We're always looking for compassionate, skilled home healthcare professionals."
>
  <PageHero eyebrow="Join our team" title="Careers" />

  <section class="py-16 sm:py-24">
    <Container size="wide">
      <SectionHeading align="center" eyebrow="Online application" class="mx-auto">
        Become an essential part of caring for our patients
        <p slot="description">
          Crystal Care Nursing, LLC recognizes the vital role that qualified,
          competent staff play in providing quality care for our clients at
          home. We're always looking for compassionate, skilled home
          healthcare professionals to support our clients whenever they need
          it. If you'd like to help us care for our clients, apply below.
        </p>
      </SectionHeading>

      <Container size="narrow" class="mt-12 !px-0">
        <div class="cn-card p-4 sm:p-6" data-animate="fade-up">
          <div class="flex justify-center">
            <Button href={site.applyUrl} variant="primary" size="lg" external>
              Open application in a new tab
            </Button>
          </div>

          <iframe
            src="https://tally.so/embed/wdPbbo?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
            width="100%"
            height="600"
            frameborder="0"
            title="Employment application"
            class="mt-6 w-full rounded-2xl border border-deep/10 bg-white"
          ></iframe>
        </div>
      </Container>
    </Container>
  </section>

  <CallToAction
    heading="Questions before you apply?"
    body="We're happy to tell you more about working with our team. Reach out any time."
  />
</BaseLayout>
