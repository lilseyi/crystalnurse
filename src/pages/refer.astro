---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import CallToAction from "../components/sections/CallToAction.astro";

const referralContacts = [
  { label: "Email", value: "crystalcarenurse@gmail.com", href: "mailto:crystalcarenurse@gmail.com" },
  { label: "Telephone", value: "240-467-7922", href: "tel:+12404677922" },
  { label: "Cell", value: "240-898-7762", href: "tel:+12408987762" },
];
---

<BaseLayout
  title="Refer a loved one"
  description="Recommend someone who could use compassionate home care. Send us their name, number, and the type of care needed."
>
  <PageHero eyebrow="Refer a loved one" title="Referrals" />

  <section class="py-16 sm:py-24">
    <Container size="wide">
      <SectionHeading align="center" eyebrow="If you know someone in need" class="mx-auto">
        Recommend someone you care about
        <p slot="description">
          Recommend those you know who may need help and care in their own
          home. We treat our patients with nothing but love and care — and we
          would love to extend that to your friend, family member, or loved
          one. Please give us a call, or preferably send us an email with
          their name, number, and the type of care required.
        </p>
      </SectionHeading>

      <div class="mx-auto mt-12 max-w-xl cn-card p-8" data-animate="fade-up">
        <dl class="divide-y divide-deep/10">
          {referralContacts.map((c) => (
            <div class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
              <dt class="w-28 flex-shrink-0 text-xs font-semibold uppercase tracking-[0.14em] text-brand">
                {c.label}
              </dt>
              <dd class="text-[0.95rem] text-ink">
                <a href={c.href} class="font-medium text-brand hover:underline">{c.value}</a>
              </dd>
            </div>
          ))}
        </dl>

        <div class="mt-8 text-center">
          <Button href="mailto:crystalcarenurse@gmail.com?subject=Referral" variant="primary" size="lg">
            Email us a referral
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <CallToAction />
</BaseLayout>
