---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import PageHero from "../components/ui/PageHero.astro";
import CallToAction from "../components/sections/CallToAction.astro";

const pillars = [
  {
    title: "Mission",
    body:
      "Our mission is to provide individualized, cost-effective, efficient skilled and non-skilled home health services to patients with chronic illnesses — and to those discharged from inpatient acute settings — helping them regain strength and functionality to prevent re-hospitalization.",
    icon: "M10 2l1.9 4.6L17 7.3l-3.5 3.4.8 4.8L10 13.2 5.7 15.5l.8-4.8L3 7.3l5.1-.7L10 2z",
  },
  {
    title: "Vision",
    body:
      "Crystal Care Nursing, LLC is committed to comprehensive, high-quality, patient-centered care focused on each patient's unique needs.",
    icon: "M10 3.5C5.5 3.5 2 10 2 10s3.5 6.5 8 6.5 8-6.5 8-6.5-3.5-6.5-8-6.5zM10 13a3 3 0 100-6 3 3 0 000 6z",
  },
  {
    title: "Goals",
    body:
      "Our goals include helping individuals improve function and live with the greatest independence. We achieve this by promoting our clients' optimal well-being and advocating for care at home rather than in a hospital or nursing home.",
    icon: "M10 2a1 1 0 011 1v.06a7 7 0 015.94 5.94H17a1 1 0 010 2h-.06A7 7 0 0111 16.94V17a1 1 0 01-2 0v-.06A7 7 0 013.06 11H3a1 1 0 010-2h.06A7 7 0 019 3.06V3a1 1 0 011-1zm0 4a4 4 0 100 8 4 4 0 000-8zm0 2.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3z",
  },
];
---

<BaseLayout
  title="About"
  description="Crystal Care Nursing, LLC is a home health care company in Potomac, Maryland, dedicated since 2017 to the highest quality of home health services."
>
  <PageHero eyebrow="Since 2017" title="About us" />

  <section class="py-16 sm:py-24">
    <Container size="narrow" class="text-center">
      <SectionHeading align="center" eyebrow="Our story" class="mx-auto" data-animate="fade-up">
        Get to know our company
        <p slot="description">
          Crystal Care Nursing, LLC is a dynamic home health care company in
          Potomac, Maryland, created in 2017 and dedicated to providing the
          highest quality of home health services. Using a team approach, we
          care for our clients without discrimination — and we believe in a
          philosophy of care that includes both the client and their family.
        </p>
      </SectionHeading>
    </Container>
  </section>

  <section class="bg-sand py-16 sm:py-24">
    <Container size="wide">
      <div class="grid gap-6 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="cn-card p-8" data-animate="fade-up">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-deep">
              <svg class="h-7 w-7 text-white" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d={p.icon} />
              </svg>
            </span>
            <h3 class="mt-6 font-display text-2xl font-normal text-deep">{p.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{p.body}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <CallToAction />
</BaseLayout>
