# Crystal Care — environment bootstrap
#
# A committed TEMPLATE holding no secrets. Every secret below is a reference
# into 1Password, following the Supa convention:
#
#     op://<vault>/<ENV_VAR_NAME>/<environment>
#
# One 1Password item per environment variable, named exactly as the variable,
# with `dev` / `staging` / `production` fields. `{{ENV}}` is filled in for you.
#
#   pnpm setup:secrets          # resolves {{ENV}}=dev  → .env.local
#   pnpm push:secrets           # .env.local            → dev deployment
#   pnpm push:secrets --prod    # resolves {{ENV}}=production → prod deployment
#
# Production values are read straight from 1Password and never written to disk.
# .env.local is git-ignored, and setup:secrets MERGES into it — replacing only
# the keys listed here and leaving anything else untouched.
#
# ── This list should stay short ─────────────────────────────────────────────
# These are the secrets that make the portal *run*. Keys for services the portal
# talks to — Google Sheets, a mailing list, an accounting tool — do NOT belong
# here. Add those in the portal: Settings → Connections. See docs/CONNECTIONS.md.
# ───────────────────────────────────────────────────────────────────────────

# ── Convex (the database and backend) ──
# CONVEX_DEPLOYMENT and CONVEX_URL are written into .env.local by
# `npx convex dev` and are deliberately NOT listed here — they identify your
# backend, and a template can't know them. `pnpm setup:secrets` preserves them.
#
# EXPO_PUBLIC_CONVEX_URL is intentionally absent too: `pnpm dev` derives it from
# CONVEX_URL, and having both in .env.local makes the Convex CLI report
# "Found multiple CONVEX_URL environment variables" and stop updating the URL.

# ── Where the portal is served from ──
# Required by @convex-dev/auth to build sign-in links. Without it, requesting a
# code fails with "Missing environment variable `SITE_URL`", which the portal
# shows only as "Couldn't send your code".
SITE_URL=http://localhost:8081
SITE_URL_PRODUCTION=https://admin.crystalnurse.com

# ── Resend (sends the six-digit sign-in codes) ──
RESEND_API_KEY=op://Crystal/RESEND_API_KEY/{{ENV}}
# Must be on a domain verified in Resend, or codes won't deliver.
AUTH_EMAIL_FROM=ops@crystalnurse.com

# ── Sign-in tokens ──
# Generated, never typed by hand. `pnpm setup:auth-keys` creates these in
# 1Password, with a DIFFERENT key pair per environment.
JWT_PRIVATE_KEY=op://Crystal/JWT_PRIVATE_KEY/{{ENV}}
JWKS=op://Crystal/JWKS/{{ENV}}

# ── Deploying (CI only — not needed on your own machine) ──
# Also stored as the CONVEX_DEPLOY_KEY secret on the GitHub repo.
CONVEX_DEPLOY_KEY=op://Crystal/CONVEX_DEPLOY_KEY/{{ENV}}
