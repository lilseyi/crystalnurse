# Crystal Care — environment bootstrap
#
# This file is a TEMPLATE, committed to the repo. It holds no secrets: every
# value below is a reference into 1Password. Turn it into a real .env.local with:
#
#   pnpm setup:secrets
#
# (which runs `op inject -i .env.example -o .env.local`). .env.local is git-ignored.
#
# ── This list should stay short ─────────────────────────────────────────────
# These are the secrets needed to make the portal *run*. Keys for services the
# portal talks to — Google Sheets, a mailing list, an accounting tool — do NOT
# belong here. Add those in the portal itself: Settings → Connections. That's
# the whole point of that screen; see docs/CONNECTIONS.md.
# ───────────────────────────────────────────────────────────────────────────

# ── Convex (the database and backend) ──
# Written for you by `npx convex dev` the first time you run it. Leave blank.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# The address the portal talks to. Same value as CONVEX_URL above; it needs the
# EXPO_PUBLIC_ prefix to be readable from the app.
EXPO_PUBLIC_CONVEX_URL=

# ── Resend (sends the six-digit sign-in codes) ──
RESEND_API_KEY=op://Crystal Care/Resend/api-key
# Must be an address on a domain verified in Resend, or codes won't deliver.
AUTH_EMAIL_FROM=ops@crystalnurse.com

# ── Sign-in tokens ──
# Generated, never typed by hand. `pnpm setup:auth-keys` creates these in
# 1Password if they don't exist yet.
JWT_PRIVATE_KEY=op://Crystal Care/Auth/jwt-private-key
JWKS=op://Crystal Care/Auth/jwks

# ── Deploying (CI only — not needed on your own machine) ──
# Also stored as the CONVEX_DEPLOY_KEY secret on the GitHub repo.
CONVEX_DEPLOY_KEY=op://Crystal Care/Convex/deploy-key
