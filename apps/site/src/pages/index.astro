---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Hero from "../components/sections/Hero.astro";
import CallToAction from "../components/sections/CallToAction.astro";
import { asset } from "../lib/asset";
import { site } from "../lib/site";

const steps = [
  {
    title: "Around the clock",
    icon: "/icons/feather-24-7.svg",
    body:
      "We provide care 24 hours a day, 7 days a week — dependable, cost-effective support whenever you need it.",
  },
  {
    title: "Referrals",
    icon: "/icons/feather-referrals.svg",
    href: "/refer",
    body:
      "Know someone who could use help and care in their own home? Refer a friend, family member, or loved one.",
  },
  {
    title: "Insurance",
    icon: "/icons/feather-insurance.svg",
    href: "/insurance",
    body:
      "Covered by Medicare, Medicaid, and private insurance. See the different ways you can pay for care.",
  },
];

const services = [
  { name: "Skilled nursing", img: "/images/service-skilled-nursing.jpeg" },
  { name: "Companionship", img: "/images/service-companionship.jpeg" },
  { name: "Personal care", img: "/images/service-personal-care.jpeg" },
  { name: "Medical social worker", img: "/images/service-medical-social-worker.jpeg" },
  { name: "Respite care", img: "/images/service-respite-care.jpeg" },
];
---

<BaseLayout title="Home">
  <Hero />

  <!-- Take a step -->
  <section class="py-16 sm:py-24">
    <Container size="wide">
      <SectionHeading eyebrow="Take a step" align="center" class="mx-auto">
        Three ways we can help today
      </SectionHeading>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {steps.map((s) => {
          const Tag = s.href ? "a" : "div";
          return (
            <Tag
              href={s.href ? asset(s.href) : undefined}
              class="cn-card group flex flex-col p-8"
              data-animate="fade-up"
            >
              <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-deep">
                <img src={asset(s.icon)} alt="" class="h-7 w-7" />
              </span>
              <h3 class="mt-6 font-display text-2xl font-normal text-deep">{s.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{s.body}</p>
              {s.href && (
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand group-hover:gap-2.5 transition-all">
                  Learn more
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M4 10h11M11 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              )}
            </Tag>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- Services -->
  <section class="bg-sand py-16 sm:py-24">
    <Container size="wide">
      <SectionHeading eyebrow="Our services" align="center" class="mx-auto">
        Care built around each person
        <p slot="description">
          Every situation is different, so every care plan is customized to you or
          your loved one's needs. A plan may include the following services:
        </p>
      </SectionHeading>

      <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-5">
        {services.map((s) => (
          <figure
            class="group relative overflow-hidden rounded-2xl shadow-soft"
            data-animate="fade-up"
          >
            <img
              src={asset(s.img)}
              alt={s.name}
              loading="lazy"
              class="aspect-[3/4] w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-deep/85 via-deep/20 to-transparent"></div>
            <figcaption class="absolute inset-x-0 bottom-0 p-4 font-display text-lg font-normal leading-tight text-white">
              {s.name}
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="mt-10 text-center">
        <a href={asset("/services")} class="inline-flex items-center gap-1.5 font-semibold text-brand hover:gap-2.5 transition-all">
          See all services
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h11M11 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </p>
    </Container>
  </section>

  <!-- Welcome -->
  <section class="py-16 sm:py-24">
    <Container size="narrow" class="text-center">
      <span class="cn-eyebrow mx-auto">Welcome</span>
      <p class="cn-prose mt-6 font-display text-2xl font-light leading-snug text-deep sm:text-3xl">
        {site.legalName} is committed to comprehensive, high-quality,
        patient-centered care focused on each patient's unique needs.
      </p>
      <p class="mt-6 text-base leading-relaxed text-muted">
        Thank you for taking the time to view our website — we hope you find
        everything you're looking for. If not, please don't hesitate to reach us
        at <a href={site.phone.href} class="font-semibold text-brand">Tel: {site.phone.display}</a>.
      </p>
    </Container>
  </section>

  <CallToAction />
</BaseLayout>
