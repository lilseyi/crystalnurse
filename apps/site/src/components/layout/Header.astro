---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { asset } from "../../lib/asset";
import { site, navLinks } from "../../lib/site";

const current = new URL(Astro.request.url).pathname.replace(/\/$/, "") || "/";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isActive = (href: string) => {
  const path = href.replace(base, "").replace(/\/$/, "") || "/";
  return path === current.replace(base, "") || path === current;
};
---

<header class="sticky top-0 z-30 border-b border-deep/10 bg-paper/85 backdrop-blur-md">
  <Container size="wide" class="flex items-center justify-between gap-6 py-3.5">
    <a href={asset("/")} class="flex-shrink-0 rounded-md" aria-label={`${site.name} — home`}>
      <img src={asset("/images/logo.png")} alt={site.name} class="h-11 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class:list={[
            "text-[0.95rem] font-medium text-ink/80 hover:text-brand",
            isActive(l.href) && !l.external && "text-brand",
          ]}
          {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <Button href={site.phone.href} variant="primary" size="sm">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11.4 11.4 0 003.6.58 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.58 3.6a1 1 0 01-.24 1z" fill="currentColor"/>
        </svg>
        {site.phone.display}
      </Button>
    </div>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-deep/20 text-deep lg:hidden"
      data-mobile-menu-trigger
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
      aria-label="Open menu"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </Container>
</header>
