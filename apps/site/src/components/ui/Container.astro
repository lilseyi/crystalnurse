---
export interface Props {
  as?: "div" | "section" | "header" | "footer" | "main" | "nav";
  class?: string;
  size?: "default" | "narrow" | "wide";
}

// Annotated so `size` resolves to the union rather than `any`. Without it,
// indexing `widths` below is an implicit-any error, and a typo in a caller's
// `size` would silently produce an undefined class.
const {
  as: Tag = "div",
  class: className = "",
  size = "default",
}: Props = Astro.props;

const widths: Record<NonNullable<Props["size"]>, string> = {
  narrow: "max-w-prose",
  default: "max-w-content",
  wide: "max-w-[82rem]",
};
---

<Tag class={`mx-auto w-full px-5 sm:px-8 ${widths[size]} ${className}`}>
  <slot />
</Tag>
