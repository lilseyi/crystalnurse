---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import PulseLine from "../ui/PulseLine.astro";
import { asset } from "../../lib/asset";
import { site } from "../../lib/site";

export interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Care that meets you at home",
  body = "Every situation is different — so every care plan is built around you or your loved one. Reach us any time to talk it through.",
} = Astro.props;
---

<section class="py-16 sm:py-24">
  <Container size="wide">
    <div
      class="relative overflow-hidden rounded-3xl bg-deep px-6 py-14 text-center text-white sm:px-12 sm:py-20"
      data-animate="fade-up"
    >
      <PulseLine class="mx-auto mb-6 h-6 w-40 opacity-80" color="#6FB7DC" />
      <h2 class="mx-auto max-w-2xl font-display text-3xl font-light leading-tight text-white sm:text-4xl">
        {heading}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-white/75">
        {body}
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={site.phone.href} variant="care" size="lg">
          Call {site.phone.display}
        </Button>
        <Button href={asset("/contact")} variant="outline" size="lg" class="!border-white/40 !text-white hover:!border-white">
          Contact us
        </Button>
      </div>
    </div>
  </Container>
</section>
